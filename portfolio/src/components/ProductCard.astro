---
interface Props {
  title: string;
  description: string;
  features: string[];
  technologies: string[];
  link?: string;
  image?: string;
}

const { title, description, features, technologies, link, image } = Astro.props;
---
<div class="card product-card">
  <div class="card-accent"></div>
  {image ? (
    <div class="product-image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  ) : (
    <div class="product-image placeholder-image">
      <div class="placeholder-content">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5; margin-bottom: 0.5rem;"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        <span>Image Coming Soon</span>
      </div>
    </div>
  )}
  <div class="product-content">
    <h3>{title}</h3>
    <p class="description">{description}</p>
    
    <div class="features">
      <h4>Key Features</h4>
      <ul>
        {features.map(feature => (
          <li>{feature}</li>
        ))}
      </ul>
    </div>
    
    <div class="tech-stack">
      {technologies.map(tech => (
        <span class="badge">{tech}</span>
      ))}
    </div>
    
    {link && (
      <div class="actions">
        <a href={link} class="btn btn-primary" target="_blank" rel="noopener noreferrer">View on Chrome Web Store</a>
      </div>
    )}
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    position: relative;
  }
  
  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--primary-color), var(--success-color));
    opacity: 0;
    transition: opacity var(--transition-normal);
    z-index: 2;
  }
  
  .product-card:hover .card-accent {
    opacity: 1;
  }
  
  @media (min-width: 768px) {
    .product-card {
      flex-direction: row;
    }
  }
  
  .product-image {
    width: 100%;
    background-color: var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }
  
  @media (min-width: 768px) {
    .product-image {
      width: 40%;
    }
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
  
  .product-content {
    padding: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .description {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }
  
  .features {
    margin-bottom: 1.5rem;
    flex: 1;
  }
  
  .features h4 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  
  .features ul {
    padding-left: 1.25rem;
    color: var(--text-color);
  }
  
  .features li {
    margin-bottom: 0.25rem;
  }
  
  .tech-stack {
    margin-bottom: 1.5rem;
  }
  
  .actions {
    margin-top: auto;
  }
</style>

---
interface Props {
  title: string;
  description: string;
  features: string[];
  technologies: string[];
  link?: string;
  image?: string;
}

const { title, description, features, technologies, link, image } = Astro.props;
---
<div class="card product-card">
  {image && (
    <div class="product-image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  <div class="product-content">
    <h3>{title}</h3>
    <p class="description">{description}</p>
    
    <div class="features">
      <h4>Key Features</h4>
      <ul>
        {features.map(feature => (
          <li>{feature}</li>
        ))}
      </ul>
    </div>
    
    <div class="tech-stack">
      {technologies.map(tech => (
        <span class="badge">{tech}</span>
      ))}
    </div>
    
    {link && (
      <div class="actions">
        <a href={link} class="btn btn-primary" target="_blank" rel="noopener noreferrer">View on Chrome Web Store</a>
      </div>
    )}
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  
  @media (min-width: 768px) {
    .product-card {
      flex-direction: row;
    }
  }
  
  .product-image {
    width: 100%;
    background-color: var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }
  
  @media (min-width: 768px) {
    .product-image {
      width: 40%;
    }
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .product-content {
    padding: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .description {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }
  
  .features {
    margin-bottom: 1.5rem;
    flex: 1;
  }
  
  .features h4 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  
  .features ul {
    padding-left: 1.25rem;
    color: var(--text-color);
  }
  
  .features li {
    margin-bottom: 0.25rem;
  }
  
  .tech-stack {
    margin-bottom: 1.5rem;
  }
  
  .actions {
    margin-top: auto;
  }
</style>

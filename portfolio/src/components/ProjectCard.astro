---
interface Props {
  title: string;
  category: string;
  description?: string;
  technologies: string[];
}

const { title, category, description, technologies } = Astro.props;

// Assign different accent colors based on category
const categoryConfig: Record<string, { icon: string; color: string }> = {
  'Salesforce Application': { icon: '☁️', color: 'var(--primary-color)' },
  'AppExchange Development': { icon: '📦', color: 'var(--accent-color)' },
  'Full-Stack Integration': { icon: '⚡', color: 'var(--success-color)' },
  'In Development': { icon: '🔨', color: 'var(--warning-color)' },
  'AI Tools': { icon: '🤖', color: 'var(--accent-color)' },
  'Developer Tool': { icon: '🧩', color: 'var(--primary-color)' },
};

const config = categoryConfig[category] || { icon: '📁', color: 'var(--primary-color)' };
---
<div class="card project-card">
  <div class="project-accent" style={`background-color: ${config.color}`}></div>
  <div class="project-body">
    <div class="project-category" style={`color: ${config.color}`}>
      <span class="category-icon">{config.icon}</span>
      {category}
    </div>
    <h3 class="project-title">{title}</h3>
    {description && <p class="project-desc">{description}</p>}
    <div class="project-tech">
      {technologies.map(tech => (
        <span class="badge">{tech}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    overflow: hidden;
  }

  .project-accent {
    height: 3px;
    width: 100%;
    flex-shrink: 0;
  }

  .project-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  .project-category {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.625rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .category-icon {
    font-size: 0.875rem;
  }
  
  .project-title {
    font-size: 1.2rem;
    margin-bottom: 0.625rem;
    line-height: 1.35;
  }
  
  .project-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }
  
  .project-tech {
    margin-top: auto;
  }
</style>

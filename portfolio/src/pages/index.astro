---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectCard from '../components/ProjectCard.astro';

const base = import.meta.env.BASE_URL;

// Chrome Extensions
const products = [
  {
    title: "Salesforce Org Visualizer & Admin Toolkit",
    description: "A Chrome extension built to help Salesforce developers and administrators inspect, understand, and manage Salesforce orgs more efficiently.",
    features: ["Org Inspector", "Profile & Permission Management", "Profile → Permission Set Converter", "Salesforce Org Limits Dashboard", "Schema Visualization", "Inline Editing", "Active / Inactive Filtering", "Production Org Protection / Watermark", "Developer productivity utilities"],
    technologies: ["Salesforce", "Chrome Extension APIs", "JavaScript", "HTML", "CSS"],
    link: "https://chromewebstore.google.com/detail/salesforce-org-visualizer/homfepohcmgopoigajcmhjikfdolijlc"
  },
  {
    title: "Salesforce Org Compare & Sync",
    description: "A Chrome extension designed to make Salesforce org comparison and synchronization workflows easier for developers and administrators.",
    features: ["Side-by-side org comparison", "Metadata comparison", "Configuration comparison", "Difference highlighting", "Sync assistance", "Salesforce developer productivity features"],
    technologies: ["Salesforce", "Chrome Extension APIs", "JavaScript", "HTML", "CSS"],
    link: "https://chromewebstore.google.com/detail/salesforce-org-compare-sy/hhalgjbefldcinchejmlebcfkdplkfkf"
  }
];

// Projects
const projects = [
  {
    title: "Property Management Application",
    category: "Salesforce Application",
    description: "An application to manage rental properties, leases, and maintenance requests. Designed data models, created Lightning Web Components, and implemented Apex classes.",
    technologies: ["Salesforce", "LWC", "Apex"]
  },
  {
    title: "Product for AppExchange",
    category: "AppExchange Development",
    description: "A product for AppExchange by building custom objects, flows, and Apex classes. Created managed packages for seamless deployment.",
    technologies: ["Salesforce", "AppExchange", "Apex", "Flows"]
  },
  {
    title: "Event Management System",
    category: "Salesforce Application",
    description: "Designed and developed an Event Management System to streamline the organization of conferences.",
    technologies: ["Salesforce"]
  },
  {
    title: "Invoice Application",
    category: "Salesforce Application",
    description: "Custom Invoice Management App tailored to the client's business.",
    technologies: ["Salesforce"]
  },
  {
    title: "Salesforce + Spring Boot Applications",
    category: "Full-Stack Integration",
    description: "Full-stack applications integrating Salesforce data with Java/Spring Boot services and cloud data platforms.",
    technologies: ["Salesforce", "Java", "Spring Boot", "APIs"]
  },
  {
    title: "Mera Business",
    category: "In Development",
    description: "An offline-first business management SaaS designed for small businesses, with business-specific workflows for inventory, sales, expenses, customers and operations.",
    technologies: ["Flutter", "SQLite", "PostgreSQL", "REST APIs"]
  },
  {
    title: "AI / Developer Productivity Experiments",
    category: "AI Tools",
    description: "Experiments with AI-assisted development, MCP, agentic workflows, and developer productivity tools.",
    technologies: ["AI", "MCP", "Agents", "Salesforce"]
  }
];

const learningAreas = [
  { name: "Salesforce Architecture", icon: "☁️" },
  { name: "Agentforce", icon: "🤖" },
  { name: "Data Cloud", icon: "📊" },
  { name: "Spring Boot", icon: "⚡" },
  { name: "AI Agents", icon: "🧠" },
  { name: "MCP", icon: "🔗" },
  { name: "Developer Productivity Tools", icon: "🛠️" },
  { name: "Cloud Architecture", icon: "🏗️" },
];

const sfCerts = [
  "Salesforce Certified Administrator",
  "Salesforce Certified Platform Developer I",
  "Salesforce Certified JavaScript Developer I",
  "Salesforce Certified Agentforce Specialist",
  "Salesforce Certified AI Specialist",
];

const copadoCerts = [
  "Copado AI",
  "Copado Fundamentals I SFP",
  "Copado Fundamentals I MP",
];
---

<BaseLayout title="Imran Pathan | Salesforce Developer & Full-Stack Engineer">
  
  <!-- ===== Hero Section ===== -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <div class="hero-content fade-in">
        <div class="hero-eyebrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          Open Source · Developer Tools
        </div>
        <h1 class="hero-title">Imran Pathan</h1>
        <p class="hero-subtitle">Salesforce Developer · Full-Stack Engineer · Developer Tools Builder</p>
        <p class="hero-description">
          I build Salesforce solutions, full-stack applications, integrations, and developer productivity tools.
          <strong>DevLab</strong> is my collection of projects, tools, experiments, and technical work.
        </p>
        <div class="hero-actions">
          <a href="#products" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            Developer Tools
          </a>
          <a href={`${base}/projects`} class="btn btn-outline">Explore Projects</a>
          <a href="https://github.com/SfImran" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
            GitHub →
          </a>
        </div>
      </div>

      <div class="hero-stats fade-in">
        <div class="hero-stat">
          <span class="hero-stat-value">5+</span>
          <span class="hero-stat-label">Years Salesforce</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-value">8</span>
          <span class="hero-stat-label">Certifications</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-value">2</span>
          <span class="hero-stat-label">Chrome Extensions</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Developer Tools Section ===== -->
  <section id="products" class="section section-alt">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Developer Tools</span>
        <h2>Chrome Extensions for Salesforce</h2>
        <p>Tools I've built to solve real problems in the Salesforce ecosystem.</p>
      </div>
      <div class="products-stack fade-in">
        {products.map(product => (
          <ProductCard {...product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Projects Section ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Portfolio</span>
        <h2>Featured Projects</h2>
        <p>A selection of technical work, integrations, and applications.</p>
      </div>
      <div class="projects-grid fade-in">
        {projects.map(project => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Currently Building & Certifications ===== -->
  <section class="section section-alt">
    <div class="container">
      <div class="two-columns fade-in">
        <!-- Currently Building -->
        <div class="column-card">
          <div class="column-card-header">
            <span class="section-label">What's Next</span>
            <h2>Currently Building & Exploring</h2>
          </div>
          <div class="learning-grid">
            {learningAreas.map(area => (
              <div class="learning-item">
                <span class="learning-icon">{area.icon}</span>
                <span class="learning-name">{area.name}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div class="column-card">
          <div class="column-card-header">
            <span class="section-label">Credentials</span>
            <h2>Certifications</h2>
          </div>
          
          <div class="cert-group">
            <div class="cert-group-header">
              <h3>Salesforce</h3>
              <span class="cert-count">{sfCerts.length} Certifications</span>
            </div>
            <ul class="cert-list">
              {sfCerts.map(cert => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {cert}
                </li>
              ))}
            </ul>
          </div>
          
          <div class="cert-group">
            <div class="cert-group-header">
              <h3>Copado</h3>
              <span class="cert-count">{copadoCerts.length} Certifications</span>
            </div>
            <ul class="cert-list">
              {copadoCerts.map(cert => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {cert}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Contact CTA ===== -->
  <section class="section contact-section">
    <div class="container">
      <div class="contact-inner fade-in">
        <h2>Let's Connect</h2>
        <p>I'm always interested in discussing Salesforce projects, developer tools, or engineering challenges.</p>
        <div class="contact-actions">
          <a href="mailto:imran.salesfore.dev@gmail.com" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Send Email
          </a>
          <a href="https://github.com/SfImran" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
            View GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 50% at 50% -20%, var(--primary-light), transparent),
      radial-gradient(ellipse 60% 40% at 80% 60%, var(--accent-light), transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  [data-theme="dark"] .hero-bg {
    opacity: 0.3;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 1.25rem;
    background-color: var(--primary-lighter);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--badge-border);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 7rem 0 5rem;
    }
    .hero-title {
      font-size: 4rem;
    }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-description strong {
    color: var(--text-color);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
  }

  .hero-stat-value {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-color);
  }

  .hero-stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ===== Sections ===== */
  .section {
    padding: 5rem 0;
  }

  .section-alt {
    background-color: var(--bg-secondary);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary-color);
    background-color: var(--primary-lighter);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--badge-border);
    margin-bottom: 0.875rem;
  }

  .section-header h2 {
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* ===== Products ===== */
  .products-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ===== Projects Grid ===== */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ===== Two Columns ===== */
  .two-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .two-columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  .column-card {
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--card-shadow);
  }

  .column-card-header {
    margin-bottom: 1.75rem;
  }

  .column-card-header h2 {
    font-size: 1.5rem;
    margin-bottom: 0;
  }

  /* ===== Learning Grid ===== */
  .learning-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .learning-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-color);
    transition: border-color var(--transition-fast);
  }

  .learning-item:hover {
    border-color: var(--primary-color);
  }

  .learning-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .learning-name {
    line-height: 1.3;
  }

  /* ===== Certifications ===== */
  .cert-group {
    margin-bottom: 1.75rem;
  }

  .cert-group:last-child {
    margin-bottom: 0;
  }

  .cert-group-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .cert-group-header h3 {
    font-size: 1.125rem;
    margin-bottom: 0;
  }

  .cert-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary-color);
    background-color: var(--primary-lighter);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .cert-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .cert-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.35rem 0;
  }

  .cert-list li svg {
    color: var(--success-color);
    flex-shrink: 0;
  }

  /* ===== Contact CTA ===== */
  .contact-section {
    border-top: 1px solid var(--border-color);
  }

  .contact-inner {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-inner h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .contact-inner p {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
